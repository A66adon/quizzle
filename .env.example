# Copy to .env. Never commit the resulting file.
# Breaking storage change: old YAML accounts/quizzes and SQLite are NOT migrated.
POSTGRES_DB=quizzle
POSTGRES_USER=quizzle
# Replace this example value with a long, independently generated password.
POSTGRES_PASSWORD=replace-with-a-random-database-password
PUBLIC_BASE_URL=https://quiz.example.com
SESSION_COOKIE_SECURE=true

# Blank allows any valid email; set a domain to restrict BOTH local and Google accounts.
ALLOWED_EMAIL_DOMAIN=
ACCOUNT_MIN_PASSWORD_LENGTH=8
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
# Per IP and auth action, per 15 minutes. Validated range 1-1000; email limit stays 10.
AUTH_RATE_LIMIT_IP_LIMIT=60

# Required for local registration/verification and password reset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=quizzle@example.com
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# For implicit TLS on port 465 use SMTP_SSL=true and SMTP_STARTTLS=false.
SMTP_SSL=false
SMTP_FROM=quizzle@example.com

# Optional: both values must be configured together. Leave both blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# For local Docker development, override PUBLIC_BASE_URL=http://localhost:8080,
# SESSION_COOKIE_SECURE=false, SMTP_HOST=mailpit, SMTP_PORT=1025,
# SMTP_AUTH=false, SMTP_STARTTLS=false, then: docker compose --profile dev up -d --build
