# Copy this file to .env and replace the value before starting the server.
# Real environment variables win over .env; .env wins over the built-in defaults.
ADMIN_PASSWORD=replace-with-a-long-local-password

# Optional overrides:
# SERVER_PORT=8080
# PUBLIC_BASE_URL=http://localhost:8080
# SESSION_COOKIE_SECURE=false
# QUIZ_FOLDER=../quizzes
# BRANDING_FOLDER=../branding
# BRANDING_FILE=branding.yaml
# QUIZ_DATABASE_PATH=../data/quiz-snapshots.db
# SNAPSHOT_INTERVAL_MS=30000
# SQLITE_BUSY_TIMEOUT_MS=5000
# SESSION_CODEHASH_LENGTH=10
# WEBSOCKET_HEARTBEAT_INTERVAL_MS=15000
# WEBSOCKET_HEARTBEAT_TIMEOUT_MS=40000
# WEBSOCKET_DISCONNECT_GRACE_MS=120000
# PLAYER_NAME_MAX_LENGTH=32
