# Standalone JDK 21 development. Copy to quizzle/.env and supply actual credentials.
# Start PostgreSQL and a development SMTP server separately (or via root Compose).
DATABASE_URL=jdbc:postgresql://localhost:5432/quizzle
DATABASE_USER=quizzle
DATABASE_PASSWORD=
PUBLIC_BASE_URL=http://localhost:8080
SESSION_COOKIE_SECURE=false
BRANDING_FOLDER=../branding
ALLOWED_EMAIL_DOMAIN=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_FROM=quizzle@localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# See root .env.example and docs/deployment.md for production deployment.
